# Raw and processed data: do not commit
data/raw/*
data/processed/*

# Generated results: ignore by default
results/*

# Allow compact, curated portfolio results
!results/portfolio/
results/portfolio/*
!results/portfolio/*.csv

# Keep empty project directories
!data/raw/.gitkeep
!data/processed/.gitkeep

# Figures: ignore generated figures for now
figures/*
!figures/.gitkeep

# Temporary files
*.tmp
*.log
.Rhistory
.RData
__pycache__/
.conda/
